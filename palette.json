{
  "name": "Vibe",
  "description": "Minimal monochrome palette with color reserved for diffs and state",
  "dark": {
    "background": "#161616",
    "panel": "#1c1c1c",
    "element": "#232323",
    "border": "#282828",
    "borderSubtle": "#333333",
    "borderActive": "#404040",
    "text": "#dcdcdc",
    "textMuted": "#8a8a8a",
    "comment": "#4a4a4a",
    "keyword": "#c7bcc2",
    "string": "#bfb7b3",
    "number": "#c5beb8",
    "type": "#c2c0cb",
    "function": "#d8d3cf",
    "operator": "#b9b9b9",
    "error": "#c45050",
    "success": "#5aaa5a",
    "warning": "#c4a840"
  },
  "light": {
    "background": "#f0f0f0",
    "panel": "#e6e6e6",
    "element": "#dbdbdb",
    "border": "#cccccc",
    "borderSubtle": "#bbbbbb",
    "borderActive": "#a0a0a0",
    "text": "#1a1a1a",
    "textMuted": "#5a5a5a",
    "comment": "#909090",
    "keyword": "#6d5f66",
    "string": "#6f6661",
    "number": "#6d6762",
    "type": "#666471",
    "function": "#23201e",
    "operator": "#686868",
    "error": "#b83a3a",
    "success": "#3a7a3a",
    "warning": "#8a7520"
  },
  "rules": {
    "syntax": "mostly grayscale",
    "diffs": "colored",
    "git": "colored",
    "diagnostics": "colored",
    "terminalAnsi": "usable but subdued"
  }
}
