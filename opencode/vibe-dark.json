{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#161616",
    "panel": "#1c1c1c",
    "element": "#232323",
    "border0": "#282828",
    "border1": "#333333",
    "border2": "#404040",
    "gray1": "#4a4a4a",
    "gray2": "#6b6b6b",
    "gray3": "#8a8a8a",
    "gray4": "#a8a8a8",
    "gray5": "#c8c8c8",
    "white": "#dcdcdc",
    "brightWhite": "#eeeeee",
    "red": "#c45050",
    "green": "#5aaa5a",
    "yellow": "#c4a840",
    "redBg": "#1e1418",
    "greenBg": "#141e14"
  },
  "theme": {
    "primary": {
      "dark": "white",
      "light": "white"
    },
    "secondary": {
      "dark": "gray4",
      "light": "gray4"
    },
    "accent": {
      "dark": "gray5",
      "light": "gray5"
    },
    "error": {
      "dark": "red",
      "light": "red"
    },
    "warning": {
      "dark": "yellow",
      "light": "yellow"
    },
    "success": {
      "dark": "green",
      "light": "green"
    },
    "info": {
      "dark": "gray4",
      "light": "gray4"
    },
    "text": {
      "dark": "white",
      "light": "white"
    },
    "textMuted": {
      "dark": "gray2",
      "light": "gray2"
    },
    "background": {
      "dark": "bg",
      "light": "bg"
    },
    "backgroundPanel": {
      "dark": "panel",
      "light": "panel"
    },
    "backgroundElement": {
      "dark": "element",
      "light": "element"
    },
    "border": {
      "dark": "border0",
      "light": "border0"
    },
    "borderActive": {
      "dark": "border2",
      "light": "border2"
    },
    "borderSubtle": {
      "dark": "border1",
      "light": "border1"
    },
    "diffAdded": {
      "dark": "green",
      "light": "green"
    },
    "diffRemoved": {
      "dark": "red",
      "light": "red"
    },
    "diffContext": {
      "dark": "gray1",
      "light": "gray1"
    },
    "diffHunkHeader": {
      "dark": "gray2",
      "light": "gray2"
    },
    "diffHighlightAdded": {
      "dark": "green",
      "light": "green"
    },
    "diffHighlightRemoved": {
      "dark": "red",
      "light": "red"
    },
    "diffAddedBg": {
      "dark": "greenBg",
      "light": "greenBg"
    },
    "diffRemovedBg": {
      "dark": "redBg",
      "light": "redBg"
    },
    "diffContextBg": {
      "dark": "panel",
      "light": "panel"
    },
    "diffLineNumber": {
      "dark": "gray1",
      "light": "gray1"
    },
    "diffAddedLineNumberBg": {
      "dark": "greenBg",
      "light": "greenBg"
    },
    "diffRemovedLineNumberBg": {
      "dark": "redBg",
      "light": "redBg"
    },
    "markdownText": {
      "dark": "white",
      "light": "white"
    },
    "markdownHeading": {
      "dark": "brightWhite",
      "light": "brightWhite"
    },
    "markdownLink": {
      "dark": "gray4",
      "light": "gray4"
    },
    "markdownLinkText": {
      "dark": "gray5",
      "light": "gray5"
    },
    "markdownCode": {
      "dark": "gray4",
      "light": "gray4"
    },
    "markdownBlockQuote": {
      "dark": "gray2",
      "light": "gray2"
    },
    "markdownEmph": {
      "dark": "gray4",
      "light": "gray4"
    },
    "markdownStrong": {
      "dark": "brightWhite",
      "light": "brightWhite"
    },
    "markdownHorizontalRule": {
      "dark": "border1",
      "light": "border1"
    },
    "markdownListItem": {
      "dark": "gray3",
      "light": "gray3"
    },
    "markdownListEnumeration": {
      "dark": "gray3",
      "light": "gray3"
    },
    "markdownImage": {
      "dark": "gray4",
      "light": "gray4"
    },
    "markdownImageText": {
      "dark": "gray5",
      "light": "gray5"
    },
    "markdownCodeBlock": {
      "dark": "gray4",
      "light": "gray4"
    },
    "syntaxComment": {
      "dark": "gray1",
      "light": "gray1"
    },
    "syntaxKeyword": {
      "dark": "white",
      "light": "white"
    },
    "syntaxFunction": {
      "dark": "white",
      "light": "white"
    },
    "syntaxVariable": {
      "dark": "white",
      "light": "white"
    },
    "syntaxString": {
      "dark": "white",
      "light": "white"
    },
    "syntaxNumber": {
      "dark": "white",
      "light": "white"
    },
    "syntaxType": {
      "dark": "white",
      "light": "white"
    },
    "syntaxOperator": {
      "dark": "white",
      "light": "white"
    },
    "syntaxPunctuation": {
      "dark": "white",
      "light": "white"
    }
  }
}
