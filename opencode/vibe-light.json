{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#f0f0f0",
    "panel": "#e6e6e6",
    "element": "#dbdbdb",
    "border0": "#cccccc",
    "border1": "#bbbbbb",
    "border2": "#a0a0a0",
    "gray1": "#909090",
    "gray2": "#737373",
    "gray3": "#5a5a5a",
    "gray4": "#414141",
    "gray5": "#2b2b2b",
    "black": "#1a1a1a",
    "deepBlack": "#111111",
    "red": "#b83a3a",
    "green": "#3a7a3a",
    "yellow": "#8a7520",
    "redBg": "#f2dede",
    "greenBg": "#def2de"
  },
  "theme": {
    "primary": {
      "dark": "black",
      "light": "black"
    },
    "secondary": {
      "dark": "gray4",
      "light": "gray4"
    },
    "accent": {
      "dark": "gray5",
      "light": "gray5"
    },
    "error": {
      "dark": "red",
      "light": "red"
    },
    "warning": {
      "dark": "yellow",
      "light": "yellow"
    },
    "success": {
      "dark": "green",
      "light": "green"
    },
    "info": {
      "dark": "gray4",
      "light": "gray4"
    },
    "text": {
      "dark": "black",
      "light": "black"
    },
    "textMuted": {
      "dark": "gray2",
      "light": "gray2"
    },
    "background": {
      "dark": "bg",
      "light": "bg"
    },
    "backgroundPanel": {
      "dark": "panel",
      "light": "panel"
    },
    "backgroundElement": {
      "dark": "element",
      "light": "element"
    },
    "border": {
      "dark": "border0",
      "light": "border0"
    },
    "borderActive": {
      "dark": "border2",
      "light": "border2"
    },
    "borderSubtle": {
      "dark": "border1",
      "light": "border1"
    },
    "diffAdded": {
      "dark": "green",
      "light": "green"
    },
    "diffRemoved": {
      "dark": "red",
      "light": "red"
    },
    "diffContext": {
      "dark": "gray1",
      "light": "gray1"
    },
    "diffHunkHeader": {
      "dark": "gray2",
      "light": "gray2"
    },
    "diffHighlightAdded": {
      "dark": "green",
      "light": "green"
    },
    "diffHighlightRemoved": {
      "dark": "red",
      "light": "red"
    },
    "diffAddedBg": {
      "dark": "greenBg",
      "light": "greenBg"
    },
    "diffRemovedBg": {
      "dark": "redBg",
      "light": "redBg"
    },
    "diffContextBg": {
      "dark": "panel",
      "light": "panel"
    },
    "diffLineNumber": {
      "dark": "gray1",
      "light": "gray1"
    },
    "diffAddedLineNumberBg": {
      "dark": "greenBg",
      "light": "greenBg"
    },
    "diffRemovedLineNumberBg": {
      "dark": "redBg",
      "light": "redBg"
    },
    "markdownText": {
      "dark": "black",
      "light": "black"
    },
    "markdownHeading": {
      "dark": "deepBlack",
      "light": "deepBlack"
    },
    "markdownLink": {
      "dark": "gray4",
      "light": "gray4"
    },
    "markdownLinkText": {
      "dark": "gray5",
      "light": "gray5"
    },
    "markdownCode": {
      "dark": "gray4",
      "light": "gray4"
    },
    "markdownBlockQuote": {
      "dark": "gray2",
      "light": "gray2"
    },
    "markdownEmph": {
      "dark": "gray4",
      "light": "gray4"
    },
    "markdownStrong": {
      "dark": "deepBlack",
      "light": "deepBlack"
    },
    "markdownHorizontalRule": {
      "dark": "border1",
      "light": "border1"
    },
    "markdownListItem": {
      "dark": "gray3",
      "light": "gray3"
    },
    "markdownListEnumeration": {
      "dark": "gray3",
      "light": "gray3"
    },
    "markdownImage": {
      "dark": "gray4",
      "light": "gray4"
    },
    "markdownImageText": {
      "dark": "gray5",
      "light": "gray5"
    },
    "markdownCodeBlock": {
      "dark": "gray4",
      "light": "gray4"
    },
    "syntaxComment": {
      "dark": "gray1",
      "light": "gray1"
    },
    "syntaxKeyword": {
      "dark": "#6d5f66",
      "light": "#6d5f66"
    },
    "syntaxFunction": {
      "dark": "#23201e",
      "light": "#23201e"
    },
    "syntaxVariable": {
      "dark": "black",
      "light": "black"
    },
    "syntaxString": {
      "dark": "#6f6661",
      "light": "#6f6661"
    },
    "syntaxNumber": {
      "dark": "#6d6762",
      "light": "#6d6762"
    },
    "syntaxType": {
      "dark": "#666471",
      "light": "#666471"
    },
    "syntaxOperator": {
      "dark": "#686868",
      "light": "#686868"
    },
    "syntaxPunctuation": {
      "dark": "#6a6a6a",
      "light": "#6a6a6a"
    }
  }
}
