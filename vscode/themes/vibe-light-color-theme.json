    "gitDecoration.untrackedResourceForeground": "#3a7a3a",
    "gitDecoration.ignoredResourceForeground": "#909090",
    "gitDecoration.conflictingResourceForeground": "#b83a3a",

    "scrollbar.shadow": "#00000010",
    "scrollbarSlider.background": "#cccccc80",
