    "editorWidget.foreground": "#1a1a1a",
    "editorWidget.border": "#cccccc",
    "editorSuggestWidget.background": "#e6e6e6",
    "editorSuggestWidget.foreground": "#1a1a1a",
    "editorSuggestWidget.border": "#cccccc",
    "editorSuggestWidget.highlightForeground": "#111111",
    "editorSuggestWidget.selectedBackground": "#cccccc",
    "editorHoverWidget.background": "#e6e6e6",
    "editorHoverWidget.border": "#cccccc",
    "editorHoverWidget.foreground": "#1a1a1a",

    "peekView.border": "#bbbbbb",
    "peekViewEditor.background": "#e6e6e6",
    "peekViewEditor.matchHighlightBackground": "#a0a0a0",
    "peekViewResult.background": "#f0f0f0",
    "peekViewResult.matchHighlightBackground": "#a0a0a0",
    "peekViewTitle.background": "#e6e6e6",
    "peekViewTitleLabel.foreground": "#1a1a1a",
    "peekViewTitleDescription.foreground": "#5a5a5a",

    "notifications.background": "#e6e6e6",
    "notifications.foreground": "#1a1a1a",
    "notifications.border": "#cccccc",
    "notificationCenterHeader.background": "#e6e6e6",
    "notificationCenterHeader.foreground": "#1a1a1a",
    "notificationsErrorIcon.foreground": "#b83a3a",
    "notificationsWarningIcon.foreground": "#8a7520",
    "notificationsInfoIcon.foreground": "#5a5a5a",

    "quickInput.background": "#e6e6e6",
    "quickInput.foreground": "#1a1a1a",
    "quickInputList.focusBackground": "#cccccc",
    "quickInputList.focusForeground": "#111111",
    "pickerGroup.border": "#cccccc",
    "pickerGroup.foreground": "#5a5a5a",

    "menu.background": "#e6e6e6",
    "menu.foreground": "#1a1a1a",
    "menu.selectionBackground": "#cccccc",
    "menu.selectionForeground": "#111111",
    "menu.separatorBackground": "#cccccc",
    "menu.border": "#cccccc",

    "terminal.background": "#f0f0f0",
    "terminal.foreground": "#1a1a1a",
    "terminal.selectionBackground": "#cccccc",
    "terminalCursor.foreground": "#1a1a1a",
    "terminal.ansiBlack": "#f0f0f0",
    "terminal.ansiRed": "#b83a3a",
    "terminal.ansiGreen": "#3a7a3a",
    "terminal.ansiYellow": "#8a7520",
    "terminal.ansiBlue": "#5a5a5a",
    "terminal.ansiMagenta": "#414141",
    "terminal.ansiCyan": "#5a5a5a",
    "terminal.ansiWhite": "#1a1a1a",
    "terminal.ansiBrightBlack": "#909090",
    "terminal.ansiBrightRed": "#c44a4a",
    "terminal.ansiBrightGreen": "#4a8a4a",
    "terminal.ansiBrightYellow": "#9a8530",
    "terminal.ansiBrightBlue": "#414141",
    "terminal.ansiBrightMagenta": "#2b2b2b",
    "terminal.ansiBrightCyan": "#414141",
    "terminal.ansiBrightWhite": "#111111",
    "terminalCommandDecoration.defaultBackground": "#909090",
    "terminalCommandDecoration.successBackground": "#3a7a3a",
    "terminalCommandDecoration.errorBackground": "#b83a3a",

    "breadcrumb.foreground": "#737373",
    "breadcrumb.focusForeground": "#414141",
    "breadcrumb.activeSelectionForeground": "#1a1a1a",
