    "checkbox.background": "#e6e6e6",
    "checkbox.border": "#bbbbbb",
    "checkbox.foreground": "#1a1a1a"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#909090", "fontStyle": "italic" }
    },
    {
      "scope": ["source", "text", "meta.embedded"],
      "settings": { "foreground": "#1a1a1a" }
    },
    {
      "scope": ["string", "string.quoted", "string.template", "string.regexp"],
      "settings": { "foreground": "#5a5a5a" }
    },
    {
      "scope": "constant.numeric",
      "settings": { "foreground": "#5a5a5a" }
    },
    {
      "scope": ["constant.language", "constant.character.escape", "constant.other", "support.constant", "support.constant.builtin"],
      "settings": { "foreground": "#414141" }
    },
    {
      "scope": ["constant.language.python", "support.function.builtin.python", "support.type.python", "support.type.exception.python"],
      "settings": { "foreground": "#1a1a1a", "fontStyle": "" }
    },
    {
      "scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#414141" }
    },
    {
      "scope": ["keyword.operator.assignment", "keyword.operator.arithmetic", "keyword.operator.comparison", "keyword.operator.logical"],
      "settings": { "foreground": "#5a5a5a" }
    },
    {
      "scope": "keyword.operator",
      "settings": { "foreground": "#5a5a5a" }
    },
    {
      "scope": ["entity.name.function", "support.function", "support.function.builtin", "support.function.misc", "support.function.builtin.python", "meta.function-call", "meta.function-call.generic.python"],
      "settings": { "foreground": "#1a1a1a" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "support.type", "support.type.builtin", "support.type.python", "support.type.exception.python", "support.class", "storage.type.annotation"],
      "settings": { "foreground": "#414141" }
    },
    {
      "scope": ["variable", "variable.other", "support.variable", "variable.parameter"],
      "settings": { "foreground": "#1a1a1a" }
    },
    {
      "scope": ["meta.function.parameters", "meta.arguments", "meta.group", "meta.parens", "meta.brace", "meta.brackets"],
      "settings": { "foreground": "#1a1a1a" }
    },
    {
      "scope": ["variable.other.constant", "variable.other.enummember"],
      "settings": { "foreground": "#2b2b2b" }
    },
    {
      "scope": "variable.language",
      "settings": { "foreground": "#414141", "fontStyle": "italic" }
    },
    {
      "scope": ["meta.object-literal.key", "support.type.property-name", "variable.other.property"],
      "settings": { "foreground": "#414141" }
    },
    {
      "scope": ["meta.indexed-name", "meta.attribute.python", "meta.function-call.python", "support.variable.magic.python", "support.function.magic.python"],
      "settings": { "foreground": "#1a1a1a" }
    },
    {
      "scope": "entity.name.tag",
      "settings": { "foreground": "#414141" }
    },
    {
      "scope": "punctuation.definition.tag",
      "settings": { "foreground": "#737373" }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": { "foreground": "#5a5a5a" }
    },
    {
      "scope": ["punctuation.definition.template-expression.begin", "punctuation.definition.template-expression.end", "punctuation.section.embedded"],
      "settings": { "foreground": "#5a5a5a" }
    },
    {
      "scope": "meta.template.expression",
      "settings": { "foreground": "#1a1a1a" }
    },
    {
      "scope": "invalid",
      "settings": { "foreground": "#b83a3a" }
    },
    {
      "scope": ["markup.heading", "markup.bold"],
      "settings": { "foreground": "#111111", "fontStyle": "bold" }
    },
    {
      "scope": "markup.italic",
      "settings": { "foreground": "#414141", "fontStyle": "italic" }
    },
    {
      "scope": "markup.inline.raw",
      "settings": { "foreground": "#414141" }
    },
    {
      "scope": "markup.inserted",
      "settings": { "foreground": "#3a7a3a" }
    },
    {
      "scope": "markup.deleted",
      "settings": { "foreground": "#b83a3a" }
    },
    {
      "scope": "markup.changed",
      "settings": { "foreground": "#8a7520" }
    },
    {
      "scope": "meta.diff.header",
      "settings": { "foreground": "#5a5a5a" }
    },
    {
      "scope": ["meta.preprocessor", "entity.name.function.preprocessor"],
      "settings": { "foreground": "#414141" }
    },
    {
      "scope": "keyword.other.unit",
      "settings": { "foreground": "#5a5a5a" }
    },
    {
      "scope": ["entity.name.tag.css", "entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css"],
      "settings": { "foreground": "#414141" }
    }
  ]
}
