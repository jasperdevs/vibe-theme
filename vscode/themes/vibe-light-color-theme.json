    "button.background": "#bbbbbb",
    "button.foreground": "#111111",
    "button.hoverBackground": "#a0a0a0",
    "button.secondaryBackground": "#dbdbdb",
    "button.secondaryForeground": "#1a1a1a",
    "button.secondaryHoverBackground": "#cccccc",

    "dropdown.background": "#e6e6e6",
    "dropdown.foreground": "#1a1a1a",
    "dropdown.border": "#bbbbbb",
    "dropdown.listBackground": "#e6e6e6",

    "list.activeSelectionBackground": "#cccccc",
    "list.activeSelectionForeground": "#111111",
    "list.hoverBackground": "#e6e6e6",
    "list.hoverForeground": "#1a1a1a",
    "list.inactiveSelectionBackground": "#dbdbdb",
    "list.inactiveSelectionForeground": "#1a1a1a",
    "list.focusBackground": "#cccccc",
    "list.focusOutline": "#a0a0a0",
    "list.highlightForeground": "#111111",
    "list.errorForeground": "#b83a3a",
    "list.warningForeground": "#8a7520",
    "list.filterMatchBackground": "#a0a0a0",
    "tree.indentGuidesStroke": "#cccccc",

    "gitDecoration.addedResourceForeground": "#3a7a3a",
    "gitDecoration.modifiedResourceForeground": "#8a7520",
    "gitDecoration.deletedResourceForeground": "#b83a3a",
